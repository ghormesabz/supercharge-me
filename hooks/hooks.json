{
  "description": "Offer a saved supercharge-me handoff for this folder at session start",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/skills/handoff/scripts/hook.sh"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
